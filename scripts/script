# Меню
help

# Начало работы программы
ls

cd home

ls

# Переход в вложенную папку
cd user
ls

# Абсолютный переход в папку /var/log
cd /var/log
ls

# Проверка на ошибки
cd /nonexistent_folder

cd /home /var

# Сброс VFS до состояния по умолчанию и переход в корень
vfs-init
cd /
ls

# Проверка на ошибки 
unknown_cmd

exit 1

# Выход из программы
exit
